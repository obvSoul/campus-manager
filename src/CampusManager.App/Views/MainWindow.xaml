<Window x:Class="CampusManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CampusManager.App.Controls"
        xmlns:v="clr-namespace:CampusManager.App.Views"
        Style="{StaticResource CmWindow}" Title="Campus Manager"
        Width="1320" Height="820" MinWidth="980" MinHeight="600" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.png">
    <Grid>
        <!-- Fond : fond d'écran Windows flouté et voilé (comme la scène derrière OneClient). -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" Margin="-60" RenderOptions.BitmapScalingMode="LowQuality" IsHitTestVisible="False">
            <Image.Effect><BlurEffect Radius="20" KernelType="Gaussian" RenderingBias="Performance" /></Image.Effect>
        </Image>
        <Rectangle Fill="{DynamicResource Veil}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Barre du haut : marque, onglets, recherche, actions -->
            <DockPanel Margin="26,0,18,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Accent}">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="C A M P U S   M A N A G E R" FontWeight="Bold" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="300" Height="38" CornerRadius="11" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,0">
                        <DockPanel>
                            <c:Icon Kind="search" Size="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Grid>
                                <TextBlock x:Name="SearchHint" Text="Rechercher un cours, un mot, un fichier…" Style="{StaticResource TMuted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="Search" Style="{StaticResource BareText}" VerticalAlignment="Center" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Button x:Name="SyncBtn" Style="{StaticResource IconBtn}" Width="38" Height="38" Margin="12,0,0,0" ToolTip="Synchroniser avec EPREL" Click="Sync_Click">
                        <c:Icon x:Name="SyncIcon" Kind="sync" Size="18" />
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Width="38" Height="38" Margin="4,0,0,0" ToolTip="Thème clair / sombre" Click="Theme_Click">
                        <c:Icon x:Name="ThemeIcon" Kind="sun" Size="17" />
                    </Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource IconBtn}" Width="38" Height="38" Margin="4,0,0,0" ToolTip="Paramètres" Click="Settings_Click">
                        <c:Icon Kind="gear" Size="18" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="Nav" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="18,0,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Matières -->
                <Border Style="{StaticResource CardBox}" Padding="8,14,8,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="MES MATIÈRES" FontSize="11" FontWeight="SemiBold" Style="{StaticResource TMuted}" Margin="10,0,10,8" />
                        <ScrollViewer Style="{StaticResource ThinScroll}" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TreePanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Contenu -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,2,0,12" MinHeight="38">
                        <Border x:Name="Modes" DockPanel.Dock="Right" Style="{StaticResource Seg}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SegBtn}" Tag="list" ToolTip="Liste détaillée" Click="Mode_Click"><c:Icon Kind="list" Size="16" /></Button>
                                <Button Style="{StaticResource SegBtn}" Tag="grid" ToolTip="Grille" Click="Mode_Click"><c:Icon Kind="grid" Size="16" /></Button>
                                <Button Style="{StaticResource SegBtn}" Tag="large" ToolTip="Grandes icônes" Click="Mode_Click"><c:Icon Kind="large" Size="16" /></Button>
                                <Button Style="{StaticResource SegBtn}" Tag="compact" ToolTip="Vue compacte" Click="Mode_Click"><c:Icon Kind="compact" Size="16" /></Button>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid x:Name="PageArea" Grid.Row="1" AllowDrop="True" DragEnter="Page_DragEnter" DragOver="Page_DragOver" DragLeave="Page_DragLeave" Drop="Page_Drop" Background="Transparent">
                        <ContentControl x:Name="PageHost" Focusable="False" />
                        <Border x:Name="DropOutline" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="16"
                                Background="{DynamicResource AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border VerticalAlignment="Top" Margin="12" Padding="16,12" CornerRadius="12" Background="{DynamicResource Accent}">
                                <StackPanel>
                                    <TextBlock x:Name="DropText" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="Fichier de Windows : copié · fichier de la bibliothèque : déplacé" Foreground="White" Opacity="0.85" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>

                <v:DetailsPane x:Name="Details" Grid.Column="3" Margin="16,0,0,0" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Notification -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,10"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" />
        </Border>
    </Grid>
</Window>
