<UserControl x:Class="CampusManager.App.Views.FileBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CampusManager.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <!-- Badges communs : favori, retiré d'EPREL, introuvable -->
        <DataTemplate x:Key="Badges">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <c:Icon Kind="star" Size="13" Foreground="{DynamicResource Warn}" Margin="6,0,0,0" Visibility="{Binding Favorite, Converter={StaticResource Vis}}" ToolTip="Favori" />
                <Border Style="{StaticResource Tag}" Background="{DynamicResource WarnSoft}" Margin="6,0,0,0" Visibility="{Binding RemoteDeleted, Converter={StaticResource Vis}}"
                        ToolTip="Retiré d'EPREL : ta copie locale est conservée">
                    <TextBlock Text="retiré d'EPREL" Foreground="{DynamicResource Warn}" />
                </Border>
                <Border Style="{StaticResource Tag}" Background="{DynamicResource BadSoft}" Margin="6,0,0,0" Visibility="{Binding Missing, Converter={StaticResource Vis}}">
                    <TextBlock Text="introuvable" Foreground="{DynamicResource Bad}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListTpl">
            <Grid Height="24" Opacity="{Binding Opacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="{Binding CourseWidth}" MinWidth="{Binding CourseMin}" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <c:FileIcon Ext="{Binding Ext}" Size="20" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <DockPanel Grid.Column="1" Margin="12,0,12,0">
                    <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource Badges}" Content="{Binding}" />
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Column="2" Style="{StaticResource Tag}"><TextBlock Text="{Binding Category}" /></Border>
                <TextBlock Grid.Column="3" Text="{Binding Course}" ToolTip="{Binding Course}" Style="{StaticResource TMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="4" Text="{Binding DateText}" Style="{StaticResource TMuted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding SizeText}" Style="{StaticResource TMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompactTpl">
            <DockPanel Opacity="{Binding Opacity}" Margin="0,-2">
                <c:FileIcon Ext="{Binding Ext}" Size="16" ShowLabel="False" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource Badges}" Content="{Binding}" />
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="GridTpl">
            <StackPanel Width="{Binding TileWidth}" Opacity="{Binding Opacity}" Margin="0,8">
                <c:FileIcon Ext="{Binding Ext}" Size="{Binding TileIcon}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,8,0,0" />
                <ContentPresenter ContentTemplate="{StaticResource Badges}" Content="{Binding}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TileSub}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="StackPanelTpl"><VirtualizingStackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTpl"><WrapPanel /></ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- En-têtes triables (vue liste) -->
        <Border x:Name="Head" Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,6" Margin="0,0,10,4">
            <Grid x:Name="HeadGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition x:Name="CourseCol" Width="200" MinWidth="120" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>
        <!-- Tri (autres vues) -->
        <StackPanel x:Name="SortBar" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Trier par" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SortBox" Width="190" SelectionChanged="SortBox_Changed">
                <ComboBoxItem Tag="name" Content="Nom" />
                <ComboBoxItem Tag="addedAt" Content="Date d'ajout" />
                <ComboBoxItem Tag="modified" Content="Date de modification" />
                <ComboBoxItem Tag="size" Content="Taille" />
                <ComboBoxItem Tag="ext" Content="Type de fichier" />
                <ComboBoxItem Tag="category" Content="Catégorie (TD, TP…)" />
                <ComboBoxItem Tag="course" Content="Matière" />
            </ComboBox>
            <Button x:Name="SortDir" Style="{StaticResource BtnGhost}" Padding="10,4" Margin="8,0,0,0" Click="SortDir_Click" ToolTip="Inverser l'ordre" />
        </StackPanel>
        <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource BareList}" Padding="0,0,0,30"
                 SelectionMode="Single" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                 PreviewMouseLeftButtonDown="List_PreviewDown" PreviewMouseMove="List_PreviewMove" ContextMenuOpening="List_ContextMenuOpening">
            <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
        </ListBox>
        <StackPanel x:Name="Empty" Grid.Row="2" HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="Collapsed">
            <c:Icon Kind="folder" Size="36" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource TMuted}" Margin="0,8,0,0" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
