<!-- Thème sombre « verre » (inspiré de OneClient) : panneaux translucides sur le fond d'écran flouté, bleu vif. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Couleur pleine (widget, fenêtres sans fond d'écran). -->
    <Color x:Key="C.Bg">#08090C</Color>
    <SolidColorBrush x:Key="Window" Color="#08090C" />
    <!-- Surfaces translucides -->
    <SolidColorBrush x:Key="Bg" Color="#66050608" />
    <SolidColorBrush x:Key="Panel" Color="#D90F1116" />
    <SolidColorBrush x:Key="Card" Color="#A10E1015" />
    <SolidColorBrush x:Key="Hover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Sel" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Text" Color="#F2F3F5" />
    <SolidColorBrush x:Key="Muted" Color="#A4A8B3" />
    <SolidColorBrush x:Key="Accent" Color="#2B5CFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#1E4BE6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#402B5CFF" />
    <SolidColorBrush x:Key="Ok" Color="#2FC56F" />
    <SolidColorBrush x:Key="OkSoft" Color="#332FC56F" />
    <SolidColorBrush x:Key="Warn" Color="#F5B83D" />
    <SolidColorBrush x:Key="WarnSoft" Color="#33F5B83D" />
    <SolidColorBrush x:Key="Bad" Color="#FF4D52" />
    <SolidColorBrush x:Key="BadSoft" Color="#33FF4D52" />
    <SolidColorBrush x:Key="Overlay" Color="#73000000" />
</ResourceDictionary>
