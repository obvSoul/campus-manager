<!-- Thème sombre = « Onyx » de Discord : noir profond, surfaces à peine relevées, accent blurple. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Bg">#070709</Color>
    <SolidColorBrush x:Key="Bg" Color="#070709" />
    <SolidColorBrush x:Key="Panel" Color="#111214" />
    <SolidColorBrush x:Key="Card" Color="#0e0e10" />
    <SolidColorBrush x:Key="Hover" Color="#1a1a1e" />
    <SolidColorBrush x:Key="Sel" Color="#24252b" />
    <SolidColorBrush x:Key="Line" Color="#1c1c20" />
    <SolidColorBrush x:Key="Text" Color="#dfe0e3" />
    <SolidColorBrush x:Key="Muted" Color="#94959c" />
    <SolidColorBrush x:Key="Accent" Color="#5865f2" />
    <SolidColorBrush x:Key="AccentHover" Color="#4752c4" />
    <SolidColorBrush x:Key="AccentSoft" Color="#335865f2" />
    <SolidColorBrush x:Key="Ok" Color="#23a55a" />
    <SolidColorBrush x:Key="OkSoft" Color="#2e23a55a" />
    <SolidColorBrush x:Key="Warn" Color="#f0b232" />
    <SolidColorBrush x:Key="WarnSoft" Color="#2ef0b232" />
    <SolidColorBrush x:Key="Bad" Color="#f23f43" />
    <SolidColorBrush x:Key="BadSoft" Color="#2ef23f43" />
    <SolidColorBrush x:Key="Overlay" Color="#73000000" />
</ResourceDictionary>
