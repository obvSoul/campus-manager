<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Bg">#F4F6FA</Color>
    <SolidColorBrush x:Key="Window" Color="#F4F6FA" />
    <SolidColorBrush x:Key="Bg" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Panel" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="Card" Color="#C7FFFFFF" />
    <SolidColorBrush x:Key="Hover" Color="#12000000" />
    <SolidColorBrush x:Key="Sel" Color="#21000000" />
    <SolidColorBrush x:Key="Line" Color="#1A000000" />
    <SolidColorBrush x:Key="Text" Color="#141824" />
    <SolidColorBrush x:Key="Muted" Color="#5A6275" />
    <SolidColorBrush x:Key="Accent" Color="#2B5CFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#1E4BE6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#332B5CFF" />
    <SolidColorBrush x:Key="Ok" Color="#1F9D63" />
    <SolidColorBrush x:Key="OkSoft" Color="#2E1F9D63" />
    <SolidColorBrush x:Key="Warn" Color="#B7791F" />
    <SolidColorBrush x:Key="WarnSoft" Color="#2EB7791F" />
    <SolidColorBrush x:Key="Bad" Color="#D64545" />
    <SolidColorBrush x:Key="BadSoft" Color="#2ED64545" />
    <SolidColorBrush x:Key="Overlay" Color="#40000000" />
    <LinearGradientBrush x:Key="Veil" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80F4F6FA" Offset="0" />
        <GradientStop Color="#A6F4F6FA" Offset="0.5" />
        <GradientStop Color="#CCF4F6FA" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
